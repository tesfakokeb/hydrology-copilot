{
  "name": "@hydro/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.cjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.cjs",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.cjs --external:pg-native --external:cpu-features --log-level=warning && node scripts/copy-static.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/websocket": "^11.0.1",
    "@hydro/config": "file:../../packages/config",
    "@hydro/hydrology-core": "file:../../packages/hydrology-core",
    "@hydro/shared-types": "file:../../packages/shared-types",
    "@hydro/units": "file:../../packages/units",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
