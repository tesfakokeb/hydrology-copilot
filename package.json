{
  "name": "hydrology-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "Hydrology Copilot \u2014 AI-Powered Water Resources Intelligence",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @hydro/api",
    "dev:web": "npm run dev --workspace @hydro/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @hydro/api",
    "db:seed": "npm run db:seed --workspace @hydro/api",
    "science:test": "cd services/science && python -m pytest -q"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
