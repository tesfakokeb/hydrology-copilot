# ---------------------------------------------------------------------------
# Hydrology Copilot — environment configuration
#
# Copy to .env and edit. Nothing here is required for local development:
# `npm install && npm run dev` runs the whole platform on the in-memory
# synthetic store with no database, no queue and no model provider.
# Every optional service that is absent is reported as such in /api/status.
# ---------------------------------------------------------------------------

# ---- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
APP_VERSION=1.0.0

# Required in production. The API refuses to start in production without it.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=30d

# The pre-loaded demonstration account. Disable before any real deployment.
ALLOW_DEMO_LOGIN=true

# Comma-separated. Not needed when the SPA and API share an origin behind nginx.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ---- Persistence -----------------------------------------------------------
# Unset: the platform runs on the in-memory synthetic store and says so.
# Set: run `npm run db:migrate && npm run db:seed` once.
# DATABASE_URL=postgres://hydro:hydro@localhost:5432/hydro
POSTGRES_USER=hydro
POSTGRES_PASSWORD=hydro
POSTGRES_DB=hydro
POSTGRES_PORT=5432

# ---- Queue -----------------------------------------------------------------
# Unset: jobs run in-process with identical lifecycle and notifications.
# REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ---- Python scientific service --------------------------------------------
# Unset: machine-learning forecasts fall back to the TypeScript baselines and
# every response says which model actually ran.
# SCIENCE_SERVICE_URL=http://localhost:8000
SCIENCE_PORT=8000

# ---- Object storage --------------------------------------------------------
# Unset: uploads are written to the local filesystem under STORAGE_ROOT.
# S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hydrology-copilot
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=hydrominio
S3_SECRET_ACCESS_KEY=hydrominio
S3_FORCE_PATH_STYLE=true
STORAGE_ROOT=./.storage
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Copilot reasoning engine ---------------------------------------------
# Unset: a deterministic keyword router selects tools and the explanation is
# composed from tool summaries. Scientific results are identical either way.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5
COPILOT_MAX_TOOL_ITERATIONS=6
COPILOT_MAX_TOKENS=4096

# ---- External model engines ------------------------------------------------
# Point each at an installed engine executable to enable its adapter. Until
# then the adapter validates inputs and reports "integration required" rather
# than fabricating a run.
# HEC_HMS_PATH=/opt/hec-hms/hec-hms.sh
# HEC_RAS_PATH=/opt/hec-ras/RasUnsteady
# SWAT_PATH=/opt/swat/swat
# SWATPLUS_PATH=/opt/swatplus/swatplus
# MODFLOW_PATH=/opt/modflow/mf6

# ---- Frontend (build-time) -------------------------------------------------
# Base URL for the API. Empty means same-origin, which is what nginx serves.
VITE_API_BASE=
# Optional MapLibre style URL for a basemap. Without it the maps draw the
# project's own layers on a plain background and no external tiles are fetched.
# VITE_BASEMAP_STYLE=https://example.org/style.json

# ---- Ports for docker compose ---------------------------------------------
API_PORT=4000
WEB_PORT=8080
